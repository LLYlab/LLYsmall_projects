def draw_boundary():
    color = (200, 0, 0)
    for x in range(NONE_FLY_ZONE, SCREEN_WIDTH - NONE_FLY_ZONE, 12):
        pygame.draw.line(screen, color, (x, NONE_FLY_ZONE), (x + 6, NONE_FLY_ZONE), 2)
        pygame.draw.line(screen, color, (x, SCREEN_HEIGHT - NONE_FLY_ZONE), (x + 6, SCREEN_HEIGHT - NONE_FLY_ZONE), 2)
    for y in range(NONE_FLY_ZONE, SCREEN_HEIGHT - NONE_FLY_ZONE, 12):
