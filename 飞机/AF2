def main():
    global selected_type_index
    clock = pygame.time.Clock()
    base = Base(SCREEN_WIDTH // 2, SCREEN_HEIGHT // 2)
    towers = []
    enemies = []
    bullets = []
    missiles = []
    wave_manager = WaveManager(anemy_r)

    running = True
    while running:
        capslock_on = bool(pygame.key.get_mods() & pygame.KMOD_CAPS)
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                running = False
            elif event.type == pygame.KEYDOWN:
                if event.key == pygame.K_TAB:
                    selected_type_index = (selected_type_index + 1) % len(TYPE_KEYS)
            elif event.type == pygame.MOUSEBUTTONDOWN:
                mx, my = pygame.mouse.get_pos()
                chosen_type = TYPE_KEYS[selected_type_index]
                if event.button == 1:
                    enemies.append(Aircraft(mx, my, random.randint(-180, 180), chosen_type, team='player', color_override=GREEN))
                elif event.button == 3:
                    enemies.append(Aircraft(mx, my, random.randint(-180, 180), chosen_type, team='enemy', color_override=RED))
                elif event.button == 2:
                    towers.append(AATower(mx, my))

        wave_manager.update(enemies)

        # 所有飞机列表（用于导弹实时追踪）
        all_aircraft = enemies  # 所有飞机

        for b in bullets[:]:
            b.update(enemies)
            if not b.alive:
                bullets.remove(b)
        for m in missiles[:]:
            m.update(all_aircraft)   # 传入所有飞机
            if not m.alive:
                missiles.remove(m)
        for e in enemies:
            e.update(enemies, base, towers, bullets, missiles, all_aircraft)
        for t in towers:
            t.update(enemies)

        enemies = [e for e in enemies if e.alive]
        towers = [t for t in towers if t.alive]

        if not base.alive:
            game_over_font = pygame.font.Font(None, 74)
            screen.blit(game_over_font.render("基地被摧毁", True, RED),
                        (SCREEN_WIDTH//2 - 200, SCREEN_HEIGHT//2 - 30))
            pygame.display.flip()
            pygame.time.wait(3000)
            running = False

        screen.fill(WHITE)
        draw_boundary()
        base.draw()
        for t in towers:
            t.draw()
        for e in enemies:
            e.draw()
        for b in bullets:
            b.draw()
        for m in missiles:
            m.draw()

        if capslock_on:
            for e in enemies:
                e.draw_indicator()

        current_key = TYPE_KEYS[selected_type_index]
        current_cn = TYPE_NAMES_CN.get(current_key, current_key)
        screen.blit(font.render(f"当前: {current_cn} (Tab切换)", True, (0,0,0)), (10, 10))
        wave_info = f"波次: {wave_manager.current_wave_index+1}/{len(anemy_r)}  状态: {wave_manager.state}"
        screen.blit(font.render(wave_info, True, (0,0,0)), (10, 35))

        pygame.display.flip()
        clock.tick(60)

    pygame.quit()
    sys.exit()

if __name__ == "__main__":
    main()
