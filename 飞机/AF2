class Base:
    def __init__(self, x, y):
        self.x = x
        self.y = y
        self.hp = 1000
        self.max_hp = 1000
        self.alive = True

    def draw(self):
        if not self.alive:
            return
        rect = pygame.Rect(self.x - 15, self.y - 15, 30, 30)
        pygame.draw.rect(screen, GREEN, rect)
